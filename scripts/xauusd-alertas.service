# Servicio systemd para dejar las alertas funcionando 24/5 en un VPS Linux (fuente cTrader).
# 1. El repo en /opt/xauusd-wyckoff-smc con su entorno virtual en .venv (ver README).
# 2. /opt/xauusd-wyckoff-smc/.env con las credenciales de Telegram y cTrader.
# 3. sudo cp scripts/xauusd-alertas.service /etc/systemd/system/
#    sudo systemctl enable --now xauusd-alertas
#    journalctl -u xauusd-alertas -f      # ver el registro
[Unit]
Description=Alertas XAUUSD Wyckoff + Smart Money
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/xauusd-wyckoff-smc
ExecStart=/opt/xauusd-wyckoff-smc/.venv/bin/python -m xauusd alertas --capital 10000
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
