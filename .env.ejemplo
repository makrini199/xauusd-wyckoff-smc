# Copia este archivo como .env (en la carpeta del proyecto) y rellénalo.
# El programa lo lee solo. No subas .env a GitHub.

# Telegram (de @BotFather y getUpdates)
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

