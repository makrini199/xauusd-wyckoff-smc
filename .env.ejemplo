# Copia este archivo como .env (en la carpeta del proyecto) y rellénalo.
# El programa lo lee solo. No subas .env a GitHub.

# Telegram (de @BotFather y getUpdates)
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# cTrader Open API (fuente por defecto). De tu aplicación en openapi.ctrader.com
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ENTORNO=demo
# Número de tu cuenta de IC Markets (opcional si solo autorizaste una)
# CTRADER_CUENTA=1234567

# MetaTrader 5 (solo con --fuente mt5, en Windows). Si el terminal ya está abierto, no hace falta.
# MT5_LOGIN=12345678
# MT5_PASSWORD=tu-contraseña
# MT5_SERVER=ICMarketsSC-Demo

# OANDA (solo con --fuente oanda)
# OANDA_TOKEN=
# OANDA_ENTORNO=practice
